<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CodeChecker's function testing workspace" />
    <title>CodeChecker | Function workspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles/styles.css" />
    <script src="javascripts/runCode.js" defer></script>
    <script src="./script.js" defer></script>
    <script src="javascripts/exportCode.js" defer></script>
  </head>
  <body>
    <div class="app-shell">
      <header class="topbar">
        <a class="brand" href="#" aria-label="CodeChecker home">
          <span class="brand-mark" aria-hidden="true">{ }</span>
          <span>CodeChecker</span>
        </a>

        <div class="topbar-actions">
          <span class="save-status" id="saveStatus">
            <span class="status-dot" aria-hidden="true"></span>
            All changes saved
          </span>
          <button class="icon-button" type="button" aria-label="Toggle theme" id="themeToggle">◐</button>
          <button class="avatar" type="button" aria-label="Log out" id="logoutButton">FM</button>
        </div>
      </header>

      <div class="workspace">
        <aside class="sidebar">
          <div class="sidebar-heading">
            <div>
              <p class="eyebrow">Workspace</p>
              <h2>My tests</h2>
            </div>
            <button class="new-test-button" type="button" id="newTestButton" aria-label="Create a new test">+</button>
          </div>

          <label class="search-field">
            <span aria-hidden="true">⌕</span>
            <input type="search" placeholder="Search tests..." id="testSearch" />
            <kbd>/</kbd>
          </label>

          <nav class="test-list" aria-label="Saved function tests" id="testList">
            <!-- Pull a link to each saved function -->
            <% savedCode.forEach((code) => { %>
            <button class="test-item active" type="button" data-test="<%= code.codeName %>">
              <span class="test-icon">JS</span>
              <span class="test-copy">
                <strong><a href="?codename=<%= code.codeName %>" class="brand"><%=code.codeName%></a></strong>
              </span>
              <span class="more" aria-hidden="true">•••</span>
            </button>
            <% }); %>
          </nav>

          <div class="sidebar-footer">
            <button class="sidebar-link" type="button"><span>?</span> Help & resources</button>
            <button class="sidebar-link" type="button"><span>↗</span> What's new</button>
          </div>
        </aside>

        <main class="main-content">
          <p id="welcomeMessage" role="status" aria-live="polite"></p>
          <div class="page-heading">
            <div>
              <div class="breadcrumb"><span>My tests</span><span>/</span><strong><%= userCodeName %></strong></div>
              <h1><%= userCodeName %></h1>
            </div>
            <div class="heading-actions">
              <button class="secondary-button" type="button" id="exportButton"><span>↓</span> Export</button>
              <button class="secondary-button" type="button" id="saveButton"><span>💾</span>Save</button>
              <button class="primary-button" type="button" id="runButton"><span>▶</span> Run function <kbd>⌘ ↵</kbd></button>
            </div>
          </div>

          <div class="content-grid">
            <section class="editor-card card">
              <div class="card-header">
                <div>
                  <p class="eyebrow">Function</p>
                  <h2>Write your code</h2>
                </div>
                <div class="language-pill"><span class="js-dot">JS</span> JavaScript <span>⌄</span></div>
              </div>
              <div class="editor-wrap">
                <div class="line-numbers" aria-hidden="true">1<br />2<br />3<br />4<br />5<br />6<br />7<br />8<br />9</div>
                <textarea id="codeEditor" spellcheck="false" aria-label="JavaScript function editor" placeholder="Enter Code here"><% if(userFunction != "") { %><%= userFunction[0].code %><%}%></textarea>
              </div>
              <div class="editor-footer">
                <span><span class="green-dot"></span> JavaScript runtime ready</span>
                <span class="editor-footer-actions"><button class="footer-button" type="button" id="copyButton">Copy code</button>
              </div>
            </section>

            <section class="input-card card">
              <div class="card-header">
                <div>
                  <p class="eyebrow">Test input</p>
                  <h2>Arguments</h2>
                </div>
                <button class="text-button" type="button" id="formatButton">Format JSON</button>
              </div>
              <label class="sr-only" for="inputEditor">function arguments</label>
              <textarea class="json-editor" id="inputEditor" spellcheck="false" placeholder="Enter Function arguments Here"></textarea>
              <div class="input-footer">
                <span class="type-label">Object</span>
                <button class="text-button" type="button" id="resetButton">Reset input</button>
              </div>
            </section>
            <section class="expected-card card">
              <div class="card-header">
                <div>
                  <p class="eyebrow">Expected result</p>
                  <h2>Expected Output</h2>
                </div>
              </div>

              <label class="sr-only" for="expectedEditor">Expected function result</label>

              <textarea class="json-editor" id="expectedEditor" spellcheck="false" placeholder="Enter expected output here"></textarea>

              <div class="input-footer">
                <span class="type-label">Object</span>
              </div>
            </section>

            <section class="output-card card">
              <div class="card-header">
                <div>
                  <p class="eyebrow">Last run <span class="run-time" id="runTime">just now</span></p>
                  <h2>Output</h2>
                </div>
                <span id="runBadge" data-status="passed">
                  <span>✓</span> Passed
                </span>
              </div>
              <pre class="output-display" id="outputDisplay"><code></code></pre>
              <div class="output-footer"><span class="green-dot"></span><span id="outputMessage">Function completed successfully</span><span class="duration">42ms</span></div>
            </section>
            <aside class="details-card card">
              <div class="card-header">
                <div>
                  <p class="eyebrow">Details</p>
                  <h2>Test metadata</h2>
                </div>
                <button class="more-button" type="button" aria-label="More test options">•••</button>
              </div>
              <dl class="metadata">
                <div><dt>Status</dt><dd><span class="green-dot"></span> Ready</dd></div>
                <div><dt>Created</dt><dd>Aug 24, 2024</dd></div>
                <div><dt>Last run</dt><dd id="lastRun">Today, 10:42 AM</dd></div>
                <div><dt>Runs this month</dt><dd>18</dd></div>
              </dl>
              <div class="tag-list"><span class="tag">transform</span><span class="tag">user-data</span><button type="button" class="add-tag">+</button></div>
            </aside>
          </div>
        </main>
      </div>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
